{
  "name": "short-url",
  "compatibility_date": "2025-06-20",
  "main": "src/worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shorturldb",
      "database_id": "3e58056d-5ec2-4132-bee8-d038ed229a3b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {},
  "kv_namespaces": [],
  "routes": [
    {
      "pattern": "sa.api.br",
      "custom_domain": true
    },
    {
      "pattern": "ue.ia.br",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  }
}
